# MAX Bot (получить на business.max.ru → Чат-боты)
MAX_BOT_TOKEN=

# Режим: polling (разработка) | webhook (прод)
MAX_MODE=polling

# Только для webhook
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8080

# TLS: путь к корневому CA Минцифры (уже лежит в deploy/)
MAX_ROOT_CA_PATH=deploy/russian_trusted_root_ca.pem

# GigaChat (опционально; без ключа текстовый ИИ выключен, CV работает)
GIGACHAT_ENABLED=false
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Хранение
STORAGE_PATH=data
LOG_LEVEL=INFO

# Политика при >4 новых пробитиях: warn | reject
OVER_LIMIT_POLICY=warn
